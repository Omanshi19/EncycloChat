# MyWebUI Environment Configuration
# Copy this to .env and fill in your values

# ─── Security ────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret-string-in-production

# ─── Ollama (Local AI) ───────────────────────────────────
# Default: http://localhost:11434
# In Docker: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434

# ─── OpenAI (or compatible API) ──────────────────────────
# Leave blank to disable OpenAI models
OPENAI_API_KEY=
# Custom base URL (e.g., for LMStudio, Groq, etc.)
OPENAI_API_BASE=https://api.openai.com/v1

# ─── Storage ─────────────────────────────────────────────
DB_PATH=data/mywebui.db
UPLOAD_DIR=data/uploads
